  .score-bar-fill { height: 100%; transition: width 0.5s ease; }
  .status-banner[data-status="SAFE"] .score-bar-fill { background: #10b981; }
  .status-banner[data-status="WARNING"] .score-bar-fill { background: #f59e0b; }
  .status-banner[data-status="DANGER"] .score-bar-fill { background: #ef4444; }
