  .findings-table th { background: #f9fafb; font-weight: 600; }
  .raw-logs { background: #1f2937; color: #a7f3d0; padding: 12px; border-radius: 6px; font-family: monospace; font-size: 0.85rem; max-height: 200px; overflow-y: auto; list-style-type: none; margin: 0; }
  .raw-logs li { margin-bottom: 4px; }
