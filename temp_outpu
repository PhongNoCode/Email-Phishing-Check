  .btn-safe { background: #10b981; color: white; }
</style>

<div class="email-card">
  <div class="email-header">
    <div class="email-title">📄 {{Extracted Filename}}</div>
    <div class="email-time">⏱️ Scan Time: Just now</div>
  </div>

  <!-- Use data-status="SAFE", "WARNING", or "DANGER" dynamically based on score -->
  <div class="status-banner" data-status="{{Dynamic Status: SAFE|WARNING|DANGER}}">
    <div>{{Dynamic Label: ✅ SAFE | ⚠️ SUSPICIOUS | 🚨 MALICIOUS (Threat Type)}}</div>
    <div class="score-container">
      <div class="score-bar-bg">
        <div class="score-bar-fill" style="width: {{Risk Score}}%;"></div>
      </div>
      <span>{{Risk Score}}/100</span>
    </div>
  </div>

  <div class="section-title">🧠 AI Reasoning</div>
  <div class="reasoning-box">
    {{Extracted Reasoning OR "No immediate threats detected. The file passed baseline security checks."}}
  </div>

  <!-- ONLY render this table if there are findings in the input text -->
  {{If Findings exist in input}}
  <div class="section-title">🔍 Detailed Findings</div>
  <table class="findings-table">
    <thead>
      <tr>
        <th>Category</th>
        <th>Status</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
