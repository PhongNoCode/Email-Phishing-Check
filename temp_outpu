      <tr>
        <td><strong>{{Category}}</strong></td>
        <td>{{Status (FAIL/MALICIOUS/SUSPICIOUS)}}</td>
        <td>{{Detailed Explanation}}</td>
      </tr>
    </tbody>
  </table>
  {{End if}}

  <div class="section-title">⚙️ System Checks (Raw Logs)</div>
  <ul class="raw-logs">
    <!-- Loop through raw checks -->
    <li><span class="score">[+{{Added Score}}]</span> {{Check Name}}: {{Result}}</li>
  </ul>

  <div class="actions">
    <!-- Change button class based on recommendation (btn-danger for Block/Quarantine, btn-safe for Pass) -->
    <button class="btn {{Dynamic Class: btn-danger | btn-safe}}">{{Extracted Action OR "➡️ PASS"}}</button>
  </div>
</div>